<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<sounds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/vehicle_sounds.xsd">
    <motorized>
        <sounds>
            <motor template="engineMedium" file="sounds/JohnDeere50G_loop.gls" linkNode="seat" linkNodeOffset="-0.9 0 -0.1"  volumeScale="2" >
                <volume outdoor="1.3" indoor="0.85">
                    <modifier type="MOTOR_RPM_REAL" value="800"  modifiedValue="0.4"/>
                    <modifier type="MOTOR_RPM_REAL" value="1200" modifiedValue="0.55"/>
                    <modifier type="MOTOR_RPM_REAL" value="1400" modifiedValue="0.72"/>
                    <modifier type="MOTOR_RPM_REAL" value="1600" modifiedValue="0.91"/>
                    <modifier type="MOTOR_RPM_REAL" value="1800" modifiedValue="1.0"/>
                    <modifier type="MOTOR_RPM_REAL" value="2000" modifiedValue="1.0"/>
                    <modifier type="MOTOR_RPM_REAL" value="2200" modifiedValue="1.0"/>
                </volume>
<!-- 				<lowpassGain indoor="0.3" outdoor="0.9" /> -->
				<pitch indoor="0.75" outdoor="0.85" />
            </motor>
            <motor template="fanModernBig_01" volumeScale="2" pitchScale="0.7" linkNodeOffset="0 2 -2"/>
            <motor template="transmissionModern_03" file="sounds/crawler_Sound.wav" volumeScale="2.5" pitchScale="1" linkNode="crawlerDriveNodeLeft4"/>
            <motor template="transmissionModern_03" file="sounds/crawler_Sound.wav" volumeScale="2.5" pitchScale="1" linkNode="crawlerDriveNodeRight4"/>
            <motor template="tracksLoop" volumeScale="2" pitchScale="0.8" linkNode="crawlerDriveNodeLeft3"/>
            <motor template="tracksLoop" volumeScale="2" pitchScale="0.8" linkNode="crawlerDriveNodeRight3"/>
            <motor template="tracksLayer" volumeScale="3" pitchScale="0.6"/>
            <motor template="cabinTractor_01" volumeScale="1" linkNode="cabin"/>
            <motor template="indoorCabinRumble" volumeScale="11" pitchScale="1.3" linkNode="cabin" linkNodeOffset="0.5 0 0"/>
            <motor template="indoorCabinRumble" volumeScale="11" pitchScale="1.1" linkNode="cabin" linkNodeOffset="-0.5 0 0"/>
        </sounds>
    </motorized>

    <enterable>
        <sounds>
            <rain template="rainInVehicle" linkNode="cabin">
                <loopSynthesisRpm>
                    <modifier type="SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="SPEED" value="10.0" modifiedValue="1" />
                </loopSynthesisRpm>
                <volume>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="5" modifiedValue="1" />
                    <modifier type="SPEED" value="10" modifiedValue="1.2" />
                </volume>

                <pitch>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="5" modifiedValue="1" />
                    <modifier type="SPEED" value="10" modifiedValue="1.0" />
                </pitch>
            </rain>
            <hail template="hailInVehicle" linkNode="cabin" volumeScale="1.5">
                <loopSynthesisRpm>
                    <modifier type="SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="SPEED" value="10" modifiedValue="1" />
                </loopSynthesisRpm>
                <volume>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="5" modifiedValue="1" />
                    <modifier type="SPEED" value="10" modifiedValue="1.2" />
                </volume>

                <pitch>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="5" modifiedValue="1" />
                    <modifier type="SPEED" value="10" modifiedValue="1.0" />
                </pitch>
            </hail>
        </sounds>
    </enterable>

    <lights>
        <sounds>
            <toggleLights template="switch01" linkNode="seat" linkNodeOffset="0 0.5 0.5" volumeScale="2.5"/>
        </sounds>
    </lights>

    <attacherJoints>
        <sounds>
            <attach template="attach01" />
            <hydraulic template="hydraulicOpen02" volumeScale="3.5" pitchScale="0.6"/>
        </sounds>
    </attacherJoints>

    <drivable>
        <sounds>
            <waterSplash template="waterSplash01" />
        </sounds>
    </drivable>

    <honk>
        <sound template="honkFendt511C" linkNode="JD50G_main_componen1" />
    </honk>
</sounds>