<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="shovel">
    <annotation>Attention exclusive model for Farming Simulator, by Peppe978. All Rights Reserved.</annotation>
    <storeData>
        <name>$l10n_shopItem_frontloaderShovel</name>
        <specs>
           <combination>John Deere 50G</combination>
		    <combination xmlFilename="johnDeere50G.xml"/>
        </specs>
        <image>store_bucketJD.png</image>
        <price>1500</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>JOHNDEERE</brand>
        <category>misc</category>
		<shopHeight>1.5</shopHeight>
		<shopRotationOffset>0 0 0</shopRotationOffset>			
        <vertexBufferMemoryUsage>59136</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>18688</indexBufferMemoryUsage>
        <textureMemoryUsage>851968</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>	

    <base>
        <typeDesc>$l10n_typeDesc_telehandlerTool</typeDesc>
        <filename>bucketJD.i3d</filename>
		<size width="1.0" length="1.0" height="1.0" />
        <components>
            <component centerOfMass="0 0.08 -0.03" solverIterationCount="10" mass="75" />
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="IMPLEMENT" />
        <mapHotspot type="TOOL" />
    </base>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="bucketAttacherJoint" hardAttach="true" jointType="Bucket" />
        </inputAttacherJoints>
    </attachable>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration name="$l10n_configuration_valueDefault" price="0">
                <fillUnits>
                    <fillUnit shopDisplayUnit="CUBICMETER" fillTypeCategories="BULK" capacity="2000" >
                        <exactFillRootNode node="exactFillRootNode" />
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>			
        </fillUnitConfigurations>
    </fillUnit>

    <fillVolume>
        <fillVolumeConfigurations>
            <fillVolumeConfiguration>
                <volumes>
                    <volume node="fillVolume" allSidePlanes="false" maxAllowedHeapAngle="60" fillUnitIndex="1" />				
                </volumes>
            </fillVolumeConfiguration>
        </fillVolumeConfigurations>

        <loadInfos>
            <loadInfo>
                <node node="fillVolumeLoadNode" width="1" length="0.5" />
            </loadInfo>
        </loadInfos>

        <unloadInfos>
            <unloadInfo>
                <node node="fillVolumeUnloadNode" width="1" length="0.5" />
            </unloadInfo>
        </unloadInfos>
    </fillVolume>
	
    <dischargeable requiresTipOcclusionArea="false">
        <dischargeNode node="fillVolumeDischargeNode" fillUnitIndex="1" emptySpeed="3500" >
            <raycast node="fillVolumeDischargeNode" maxDistance="30" useWorldNegYDirection="true" yOffset="2"/>
            <info width="1.0" length="1" zOffset="0.5"/>
            <effects>
                <effectNode effectClass="TipEffect">
                    <effectNode effectNode="emitterShape" effectClass="ParticleEffect" materialType="unloadingParticle"/>
                    <effectNode effectNode="grainNorm" materialType="unloading" materialTypeId="3" fadeTime="0.2" alignXAxisToWorldY="true" />
                </effectNode>
                <effectNode effectNode="smokeNorm" materialType="smoke" materialTypeId="1" fadeTime="0.5" />
            </effects>
        </dischargeNode>
    </dischargeable>

    <shovel>
        <shovelNode node="pickUpNode" fillUnitIndex="1" loadInfoIndex="1" width="1.2" length="0.5" needsMovement="true" maxPickupAngle="140"/>
        <dischargeInfo node="fillVolumeDischargeNode" minSpeedAngle="145" maxSpeedAngle="175" />
    </shovel>
	
	<groundReferenceNodes>
        <groundReferenceNode node="groundReferenceNode" onlyActiveWhenLowered="false" forceFactor="1" threshold="0.115"/>
    </groundReferenceNodes>	

    <foliageBending>
        <bendingNode minX="-0.45" maxX="0.45" minZ="-0.55" maxZ="0.35" yOffset="-0.02" />
    </foliageBending>
	
    <ai>
        <agentAttachment width="1.0" height="0.9" length="1.0" lengthOffset="-0.1"/>
    </ai>
		
	<baseColorConfigurations price="200" useDefaultColors="false">
		<baseColorConfiguration name="$l10n_ui_colorYellow"  color="0.80 0.4 0.0"/>
        <baseColorConfiguration name="$l10n_ui_colorBlack"   color="0.02 0.02 0.02"/>
        <material materialSlotName="JD50G_mat"/>
    </baseColorConfigurations>	
	
    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="4" fieldMultiplier="2"/>

	<i3dMappings>
	  <i3dMapping id="bucketJD_main_component1" node="0>" />
	  <i3dMapping id="bucketAttacherJoint" node="0>0" />
	  <i3dMapping id="shovel_vis" node="0>1" />
	  <i3dMapping id="fillVolumes" node="0>1|0" />
	  <i3dMapping id="fillVolume" node="0>1|0|0" />
	  <i3dMapping id="fillVolumeDischargeNode" node="0>1|0|1" />
	  <i3dMapping id="fillVolumeLoadNode" node="0>1|0|2" />
	  <i3dMapping id="fillVolumeUnloadNode" node="0>1|0|3" />
	  <i3dMapping id="effectNodeRot" node="0>1|1" />
	  <i3dMapping id="grainNorm" node="0>1|1|0" />
	  <i3dMapping id="smokeNorm" node="0>1|1|1" />
	  <i3dMapping id="exactFillRootNode" node="0>1|2" />
	  <i3dMapping id="emitterShape" node="0>1|3" />
	  <i3dMapping id="pickUpNode" node="0>1|4" />
	  <i3dMapping id="tipTrigger" node="0>2" />
	  <i3dMapping id="workArea" node="0>3" />
	  <i3dMapping id="workAreaStart" node="0>3|0" />
	  <i3dMapping id="workAreaWidth" node="0>3|1" />
	  <i3dMapping id="workAreaHeight" node="0>3|2" />
	  <i3dMapping id="groundReferenceNode" node="0>3|3" />
	  <i3dMapping id="collisionShovel" node="0>4" />
	  <i3dMapping id="col1" node="0>4|0" />
	  <i3dMapping id="col2" node="0>4|1" />
	  <i3dMapping id="col3" node="0>4|2" />
	</i3dMappings>
	
</vehicle>
