    <Material name="preScreenDecal_decalMat" materialId="9" customShaderId="18">
      <Texture fileId="17"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <CustomParameter name="lightControl" value="0"/>
    </Material>
    <Material name="preScreenDecal_decalMat" materialId="10" customShaderId="18">
      <Texture fileId="17"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="rearcamera.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="rearCamera" nodeId="16">
      <Camera name="rearCamera_camera" translation="-0.315038 -0.0702878 -0.478755" rotation="179.312 -40.59 -180" nodeId="17" fov="60" nearClip="0.1" farClip="1000" orthographicHeight="1"/>
      <TransformGroup name="boxRoot" nodeId="18">
        <Shape name="box" shapeId="1" nodeId="19" castsShadows="true" receiveShadows="true" materialIds="7,8,5"/>
        <Shape name="preloadScreen" shapeId="2" nodeId="20" castsShadows="true" receiveShadows="true" materialIds="10"/>
        <Shape name="cameraDecals" translation="0 0 -0.000593594" shapeId="3" nodeId="21" castsShadows="true" receiveShadows="true" materialIds="9"/>
