<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<sounds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/vehicle_sounds.xsd">
    <motorized>
        <sounds>
			<motor template="engineMedium" file="$data/vehicles/sennebogen/series835G/sounds/series835G.gls" inkNodeOffset="0 2 -1" pitchScale="1" volumeScale="1.5"/>
            <motor template="indoorCabinRumble" linkNodeOffset="-0.5 2.5 -0.5" volumeScale="7" pitchScale="0.8"/>
            <motor template="indoorCabinRumble" linkNodeOffset="0.5 2.5 -0.5"  pitchScale="1.0" volumeScale="8"/>
            <motor template="fanModern_01" linkNodeOffset="0 1.7 3" />
            <motor template="cabinTractor_01" linkNodeOffset="-0.5 3 -0.5" volumeScale="1.5" pitchScale="1.1"/>
            <motor template="cabinTractor_01" linkNodeOffset="0.5 3 -0.5"  volumeScale="1.5" pitchScale="1.0"/>
            <compressedAir template="compressedAir"/>
            <airCompressorRun template="brakeCompressorLarge" volumeScale="0.8"/>
            <airCompressorStop template="compressedAir"/>
			<motor file="$data/vehicles/impex/hannibalT50/sounds/tracksLoop.wav" linkNode="0>" pitchScale="0.70" volumeScale="12.0" innerRadius="1.2" outerRadius="35">
                <volume indoor="0.4" outdoor="1">
                    <modifier type="SPEED"      value="0"   modifiedValue="0" />
                    <modifier type="SPEED"      value="10"   modifiedValue="1.2" />
                </volume>
                <pitch indoor="0.7" outdoor="0.7" >
                    <modifier type="SPEED"      value="0"   modifiedValue="0.5" />
                    <modifier type="SPEED"      value="10"   modifiedValue="0.6" />
                </pitch>
            </motor>
			<motor template="engineSmall" file="$data/vehicles/impex/hannibalT50/sounds/t50_tracksLayer.wav" linkNode="0>" pitchScale="1" volumeScale="5" innerRadius="1" outerRadius="15">
                <volume outdoor="1.0" indoor="0.2">
                    <modifier type="SPEED"      value="0"   modifiedValue="0" />
                    <modifier type="SPEED"      value="10"   modifiedValue="1" />
                </volume>
                <pitch indoor="0.7" outdoor="0.7" >
                    <modifier type="SPEED"      value="0"   modifiedValue="0.3" />
                    <modifier type="SPEED"      value="10"   modifiedValue="0.4" />
                </pitch>
				<lowpassGain indoor="0.25" outdoor="1.0" />
            </motor>
			
        </sounds>
    </motorized>

    <enterable>
        <sounds>
            <rain template="rainInVehicle"  linkNodeOffset="0 3.3 -0.7">
                <loopSynthesisRpm>
                    <modifier type="SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="SPEED" value="53.0" modifiedValue="1" />
                </loopSynthesisRpm>
                <volume>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="35" modifiedValue="1" />
                    <modifier type="SPEED" value="53" modifiedValue="1.2" />
                </volume>

                <pitch>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="35" modifiedValue="1" />
                    <modifier type="SPEED" value="53" modifiedValue="1.0" />
                </pitch>
            </rain>
            <hail template="hailInVehicle" linkNodeOffset="0 3.3 -0.7" volumeScale="1.5">
                <loopSynthesisRpm>
                    <modifier type="SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="SPEED" value="60.0" modifiedValue="1" />
                </loopSynthesisRpm>
                <volume>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="25" modifiedValue="1" />
                    <modifier type="SPEED" value="60" modifiedValue="1.2" />
                </volume>

                <pitch>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="25" modifiedValue="1" />
                    <modifier type="SPEED" value="60" modifiedValue="1.0" />
                </pitch>
            </hail>
        </sounds>
    </enterable>

    <lights>
        <sounds>
            <toggleLights template="switch01"  />
            <turnLight template="switchTurnlight"  />
        </sounds>
    </lights>

    <attacherJoints>
        <sounds>
            <attach template="attach01" />
            <hydraulic template="hydraulicOpen01" />
        </sounds>
    </attacherJoints>

    <drivable>
        <sounds>
            <waterSplash template="waterSplash01" />
        </sounds>
    </drivable>

    <ai>
        <automaticSteering>
            <sounds>
                <engage template="gpsEngageFendt"/>
                <disengage template="gpsDisengageFendt"/>
                <lineEnd template="gpsLineEndFendt"/>
            </sounds>
        </automaticSteering>
    </ai>

    <honk>
        <sound template="honkFendt511C" />
    </honk>
</sounds>
