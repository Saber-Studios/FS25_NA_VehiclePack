<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<sounds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/vehicle_sounds.xsd">
    <motorized>
        <sounds>
            <motor template="engineLarge" file="$data/vehicles/johnDeere/seriesS7/sounds/seriesX9.gls" volumeScale="2.8">
                <lowpassCutoffFrequency indoor="250" outdoor="12000" />
                <lowpassGain indoor="0.3" outdoor="0.4" />
            </motor>
			<motor template="engineLarge" file="$data/vehicles/johnDeere/seriesS7/sounds/seriesX9.gls" volumeScale="2.8" linkNode="0>0|7|3|0|1|0">
                <lowpassCutoffFrequency indoor="250" outdoor="12000" />
                <lowpassGain indoor="0.3" outdoor="0.4" />
				<volume outdoor="0" indoor="1.0"/>
            </motor>
			
            <motor template="fanHarvester01" linkNodeOffset="-1.5 3.5 -2" volumeScale="3.5" pitchScale="1.1"/>
            <motor file="$data/vehicles/johnDeere/seriesS7/sounds/Transmission.gls" linkNode="crawlerLeftFrontWheel" pitchScale="0.7" volumeScale="4.2" innerRadius="1" outerRadius="40" fadeIn="0.9" isLocalSound="true">
                <loopSynthesisRpm>
                    <modifier type="DIFFERENTIAL_SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="DIFFERENTIAL_SPEED" value="20.0" modifiedValue="0.5" />
                    <modifier type="DIFFERENTIAL_SPEED" value="40.0" modifiedValue="1.0" />
                </loopSynthesisRpm>
                <volume indoor="0.45" outdoor="1.5" >
                    <modifier type="DIFFERENTIAL_SPEED" value="0.0"  modifiedValue="0.00" />
                    <modifier type="DIFFERENTIAL_SPEED" value="5.0"  modifiedValue="0.55" />
                    <modifier type="DIFFERENTIAL_SPEED" value="10.0" modifiedValue="0.65" />
                    <modifier type="DIFFERENTIAL_SPEED" value="20.0" modifiedValue="0.90" />
                    <modifier type="DIFFERENTIAL_SPEED" value="43.0" modifiedValue="1.20" />

                    <modifier type="MOTOR_LOAD" value="-1.00" modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.00"  modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.20"  modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.30"  modifiedValue="1.2" />
                    <modifier type="MOTOR_LOAD" value="0.45"  modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.80"  modifiedValue="0.75" />
                    <modifier type="MOTOR_LOAD" value="1.00"  modifiedValue="0.65" />
                </volume>
                <pitch>
                    <modifier type="SUSPENSION" value="-0.08" modifiedValue="1.07" />
                    <modifier type="SUSPENSION" value="-0.02" modifiedValue="1.05" />
                    <modifier type="SUSPENSION" value="0.0" modifiedValue="1.0" />
                    <modifier type="SUSPENSION" value="0.02" modifiedValue="1.05" />
                    <modifier type="SUSPENSION" value="0.08" modifiedValue="1.08" />
                </pitch>
                <lowpassCutoffFrequency indoor="250" outdoor="20000" />
                <lowpassGain indoor="0.3" outdoor="1" />
            </motor>
            <motor file="$data/vehicles/johnDeere/seriesS7/sounds/Transmission.gls" linkNode="crawlerRightFrontWheel" pitchScale="0.5" volumeScale="4.7" innerRadius="1" outerRadius="40" fadeIn="0.9">
                <loopSynthesisRpm>
                    <modifier type="DIFFERENTIAL_SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="DIFFERENTIAL_SPEED" value="20.0" modifiedValue="0.5" />
                    <modifier type="DIFFERENTIAL_SPEED" value="40.0" modifiedValue="1.0" />
                </loopSynthesisRpm>
                <volume indoor="0.45" outdoor="1.5" >
                    <modifier type="DIFFERENTIAL_SPEED" value="0.0"  modifiedValue="0.00" />
                    <modifier type="DIFFERENTIAL_SPEED" value="5.0"  modifiedValue="0.55" />
                    <modifier type="DIFFERENTIAL_SPEED" value="10.0" modifiedValue="0.65" />
                    <modifier type="DIFFERENTIAL_SPEED" value="20.0" modifiedValue="0.90" />
                    <modifier type="DIFFERENTIAL_SPEED" value="43.0" modifiedValue="1.20" />

                    <modifier type="MOTOR_LOAD" value="-1.00" modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.00"  modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.20"  modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.30"  modifiedValue="1.2" />
                    <modifier type="MOTOR_LOAD" value="0.45"  modifiedValue="1.0" />
                    <modifier type="MOTOR_LOAD" value="0.80"  modifiedValue="0.75" />
                    <modifier type="MOTOR_LOAD" value="1.00"  modifiedValue="0.65" />
                </volume>
                <pitch>
                    <modifier type="SUSPENSION" value="-0.08" modifiedValue="1.07" />
                    <modifier type="SUSPENSION" value="-0.02" modifiedValue="1.05" />
                    <modifier type="SUSPENSION" value="0.0" modifiedValue="1.0" />
                    <modifier type="SUSPENSION" value="0.02" modifiedValue="1.05" />
                    <modifier type="SUSPENSION" value="0.08" modifiedValue="1.08" />
                </pitch>
                <lowpassCutoffFrequency indoor="250" outdoor="20000" />
                <lowpassGain indoor="0.3" outdoor="1" />
            </motor>
            <motor file="$data/vehicles/johnDeere/seriesS7/sounds/seriesX9_cabinBeep.wav" innerRadius="1.0" outerRadius="10.0" loops="1" linkNodeOffset="0 3 3" supportsReverb="false">
                <volume indoor="1.4" outdoor="0.0" />
            </motor>
            <gearbox template="cabinHarvester01" linkNodeOffset="0 3 3" volumeScale="8.5" />
            <motor template="indoorCabinRumble" volumeScale="20" pitchScale="1.3" linkNodeOffset="-0.5 3 3"/>
            <motor template="indoorCabinRumble" volumeScale="20" pitchScale="1.1" linkNodeOffset="0.5 3 3"/>
            <reverseDrive template="reverseBeep01" volumeScale="1.3"/>
        </sounds>
    </motorized>

    <enterable>
        <sounds>
            <rain template="rainInVehicle"  linkNodeOffset="0 3 3">
                <loopSynthesisRpm>
                    <modifier type="SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="SPEED" value="26.0" modifiedValue="1" />
                </loopSynthesisRpm>
                <volume>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="15" modifiedValue="1" />
                    <modifier type="SPEED" value="25" modifiedValue="1.2" />
                </volume>

                <pitch>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="15" modifiedValue="1" />
                    <modifier type="SPEED" value="25" modifiedValue="1.0" />
                </pitch>
            </rain>
            <hail template="hailInVehicle" linkNodeOffset="0 3 3" volumeScale="1.5">
                <loopSynthesisRpm>
                    <modifier type="SPEED" value="0.0" modifiedValue="0.0" />
                    <modifier type="SPEED" value="25" modifiedValue="1" />
                </loopSynthesisRpm>
                <volume>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="10" modifiedValue="1" />
                    <modifier type="SPEED" value="25" modifiedValue="1.2" />
                </volume>

                <pitch>
                    <modifier type="SPEED" value="0" modifiedValue="1" />
                    <modifier type="SPEED" value="10" modifiedValue="1" />
                    <modifier type="SPEED" value="25" modifiedValue="1.0" />
                </pitch>
            </hail>
        </sounds>
    </enterable>

    <lights>
        <sounds>
            <toggleLights template="switch01"  />
            <turnLight template="switchTurnlightJD"  />
        </sounds>
    </lights>

    <attacherJoints>
        <sounds>
            <attach template="headerAttach01" linkNode="attacherJointCutter"/>
            <hydraulic template="hydraulicOpen02" linkNode="attacherJointCutter" pitchScale="1.4" volumeScale="2.4"/>
        </sounds>
    </attacherJoints>

    <drivable>
        <sounds>
            <waterSplash template="waterSplash01" linkNode="attacherJointCutter"/>
        </sounds>
    </drivable>

        <turnOnVehicle>
            <sounds>
                <start template="combineThreshingSystemStart"  volumeScale="0.6"/>
                <work  template="combineThreshingSystemLoop"   volumeScale="0.6"/>
                <stop  template="combineThreshingSystemStop"   volumeScale="0.6"/>
            </sounds>
        </turnOnVehicle>

    <combine>
        <sounds>
            <chopStraw   template="chopStrawDischarge" linkNode="0>0|6|3|3|0" volumeScale="3.5"/>
            <dropStraw   template="dropStrawDischarge" linkNode="0>0|6|3|3|0" volumeScale="3.5"/>
            <fill        template="grainTankMediumFill" volumeScale="0.6" linkNodeOffset="0 5 0"/>
        </sounds>
    </combine>

    <ai>
        <automaticSteering>
            <sounds>
                <engage    template="gpsEngageJohnDeere" volumeScale="1.3"/>
                <disengage template="gpsDisengageJohnDeere" volumeScale="1.3"/>
                <lineEnd   template="gpsLineEndJohnDeere" volumeScale="1.3"/>
            </sounds>
        </automaticSteering>
    </ai>

    <honk>
        <sound template="honkJohnDeereHarvester" volumeScale="2.4"/>
    </honk>
</sounds>
